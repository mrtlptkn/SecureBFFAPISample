<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JwtBffSample</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
    <header class="bg-white shadow-sm">
        <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
            <a asp-controller="Dashboard" asp-action="Index" class="font-semibold">JwtBffSample</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-4 text-sm">
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.Users.Read))
                    {
                        <a asp-controller="Admin" asp-action="Users" class="hover:underline">Kullanıcılar</a>
                    }
                    <span class="text-slate-500">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-white hover:bg-slate-700">Çıkış</button>
                    </form>
                </div>
            }
        </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
        @if (TempData["Message"] is string message)
        {
            <div class="mb-6 rounded bg-sky-50 p-3 text-sm text-sky-800">@message</div>
        }

        @RenderBody()
    </main>
</body>
</html>
