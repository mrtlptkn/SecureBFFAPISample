@model DashboardViewModel
@{
    ViewData["Title"] = "Panel";
    var canWriteProducts = Model.Permissions.Contains(Permissions.Products.Write);
}

<h1 class="text-2xl font-semibold">Merhaba, @Model.Email</h1>

<section class="mt-4 rounded-xl bg-white p-6 shadow">
    <h2 class="font-medium">Yetkileriniz</h2>
    <div class="mt-3 flex flex-wrap gap-2">
        @foreach (var permission in Model.Permissions)
        {
            <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs">@permission</span>
        }
    </div>
</section>

@if (Model.Permissions.Contains(Permissions.Products.Read))
{
    <section class="mt-6 rounded-xl bg-white p-6 shadow">
        <h2 class="mb-3 font-medium">Ürünler</h2>

        @if (Model.Error is not null)
        {
            <p class="text-sm text-red-600">@Model.Error</p>
        }

        <table class="w-full text-left text-sm">
            <thead class="text-slate-500">
                <tr>
                    <th class="py-2">Ad</th>
                    <th class="py-2">Fiyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr class="border-t">
                        <td class="py-2">@product.Name</td>
                        <td class="py-2">@product.Price.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (canWriteProducts)
        {
            <form asp-action="CreateProduct" method="post" class="mt-6 flex flex-wrap items-end gap-3 border-t pt-4">
                <div>
                    <label class="block text-sm font-medium" for="name">Ad</label>
                    <input id="name" name="name" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium" for="price">Fiyat</label>
                    <input id="price" name="price" type="number" step="0.01" min="0" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
                </div>
                <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white hover:bg-slate-700">Ürün ekle</button>
            </form>
        }
    </section>
}
